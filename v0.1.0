local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local CONFIG = {
    SPAWN_COUNT = 500,
    SPAWN_INTERVAL = 0.05,
    AREA_SIZE = 100,
    PART_SIZE = Vector3.new(2, 2, 2),
}

local testContainer = Instance.new("Folder")
testContainer.Name = "StressTestContainer"
testContainer.Parent = Workspace

local isTesting = true
local spawnedCount = 0

local function createTestObject(position: Vector3)
    local part = Instance.new("Part")
    part.Size = CONFIG.PART_SIZE
    part.Position = position
    part.Material = Enum.Material.SmoothPlastic
    part.Color = Color3.fromRGB(math.random(50, 255), math.random(50, 255), math.random(50, 255))
    part.CanCollide = true
    part.Anchored = false
    part.Parent = testContainer
end

task.spawn(function()
    while isTesting and spawnedCount < CONFIG.SPAWN_COUNT do
        local randomX = math.random(-CONFIG.AREA_SIZE/2, CONFIG.AREA_SIZE/2)
        local randomZ = math.random(-CONFIG.AREA_SIZE/2, CONFIG.AREA_SIZE/2)
        local spawnPos = Vector3.new(randomX, 50, randomZ)
        
        createTestObject(spawnPos)
        spawnedCount += 1
        
        task.wait(CONFIG.SPAWN_INTERVAL)
    end
end)

local lastTime = os.clock()
local frameCount = 0

RunService.Heartbeat:Connect(function()
    frameCount += 1
    local currentTime = os.clock()
    
    if currentTime - lastTime >= 1.0 then
        local fps = frameCount / (currentTime - lastTime)
        print(string.format("[METRICS] FPS: %.2f | Spawned: %d", fps, spawnedCount))
        frameCount = 0
        lastTime = currentTime
    end
end)
