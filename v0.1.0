local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SpeedControllerUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 110)
mainFrame.Position = UDim2.new(0.01, 0, 0.4, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true -- Cho phép kéo thả vị trí khung UI
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 25)
titleLabel.Position = UDim2.new(0, 0, 0, 5)
titleLabel.Text = "CHỈNH TỐC ĐỘ CHẠY"
titleLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.SourceSansBold
titleLabel.TextSize = 14
titleLabel.Parent = mainFrame

-- Ô nhập số tốc độ (TextBox)
local speedInput = Instance.new("TextBox")
speedInput.Size = UDim2.new(0.8, 0, 0, 30)
speedInput.Position = UDim2.new(0.1, 0, 0, 35)
speedInput.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
speedInput.TextColor3 = Color3.fromRGB(255, 255, 255)
speedInput.PlaceholderText = "Nhập tốc độ (VD: 16, 50, 100)"
speedInput.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
speedInput.Font = Enum.Font.SourceSans
speedInput.TextSize = 14
speedInput.Text = ""
speedInput.ClearTextOnFocus = false
speedInput.Parent = mainFrame

local inputCorner = Instance.new("UICorner")
inputCorner.CornerRadius = UDim.new(0, 4)
inputCorner.Parent = speedInput

-- Nút bấm Áp dụng
local applyBtn = Instance.new("TextButton")
applyBtn.Size = UDim2.new(0.8, 0, 0, 25)
applyBtn.Position = UDim2.new(0.1, 0, 0, 72)
applyBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
applyBtn.Text = "Áp dụng tốc độ"
applyBtn.Font = Enum.Font.SourceSansBold
applyBtn.TextSize = 14
applyBtn.Parent = mainFrame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 4)
btnCorner.Parent = applyBtn

-- Hàm cập nhật WalkSpeed cho nhân vật
local function setWalkSpeed(speedValue)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = speedValue
    end
end

-- Xử lý sự kiện khi ấn nút hoặc bấm Enter trong TextBox
local function onApply()
    local newSpeed = tonumber(speedInput.Text)
    if newSpeed and newSpeed > 0 then
        setWalkSpeed(newSpeed)
    else
        speedInput.Text = ""
        speedInput.PlaceholderText = "Vui lòng nhập số hợp lệ!"
    end
end

applyBtn.MouseButton1Click:Connect(onApply)
speedInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        onApply()
    end
end)

-- Tự động duy trì tốc độ khi nhân vật hồi sinh (Respawn)
LocalPlayer.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid")
    local currentSpeed = tonumber(speedInput.Text)
    if currentSpeed and currentSpeed > 0 then
        humanoid.WalkSpeed = currentSpeed
    end
end)
