local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Tạo ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SpeedControllerHub"
screenGui.ResetOnSpawn = false
screenGui.Parent = game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

-- Khung chính (Đặt chính giữa màn hình, kích thước lớn)
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 320, 0, 180)
mainFrame.Position = UDim2.new(0.5, -160, 0.5, -90) -- Căn giữa màn hình
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = mainFrame

-- Tiêu đề & Nút Đóng/Mở
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -40, 0, 35)
titleLabel.Position = UDim2.new(0, 10, 0, 5)
titleLabel.Text = "HỮU KHANG SPEED HUB (Ấn F4 để Ẩn/Hiện)"
titleLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.SourceSansBold
titleLabel.TextSize = 14
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Parent = mainFrame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -35, 0, 5)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Font = Enum.Font.SourceSansBold
closeBtn.TextSize = 16
closeBtn.Parent = mainFrame

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeBtn

-- Ô nhập tốc độ (To, rõ)
local speedInput = Instance.new("TextBox")
speedInput.Size = UDim2.new(0.9, 0, 0, 45)
speedInput.Position = UDim2.new(0.05, 0, 0.28, 0)
speedInput.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
speedInput.TextColor3 = Color3.fromRGB(255, 255, 0)
speedInput.PlaceholderText = "Nhập tốc độ (VD: 50, 100, 200)..."
speedInput.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
speedInput.Font = Enum.Font.SourceSansBold
speedInput.TextSize = 18
speedInput.Text = ""
speedInput.ClearTextOnFocus = false
speedInput.Parent = mainFrame

local inputCorner = Instance.new("UICorner")
inputCorner.CornerRadius = UDim.new(0, 8)
inputCorner.Parent = speedInput

-- Nút Bật/Tắt Áp dụng
local applyBtn = Instance.new("TextButton")
applyBtn.Size = UDim2.new(0.9, 0, 0, 40)
applyBtn.Position = UDim2.new(0.05, 0, 0.65, 0)
applyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
applyBtn.Text = "KÍCH HOẠT TỐC ĐỘ"
applyBtn.Font = Enum.Font.SourceSansBold
applyBtn.TextSize = 16
applyBtn.Parent = mainFrame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = applyBtn

-- Biến xử lý logic
local targetSpeed = 16
local isEnabled = false

applyBtn.MouseButton1Click:Connect(function()
    local val = tonumber(speedInput.Text)
    if val then
        targetSpeed = val
        isEnabled = true
        applyBtn.Text = "ĐÃ BẬT TỐC ĐỘ: " .. tostring(val)
        applyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    else
        isEnabled = false
        applyBtn.Text = "VUI LÒNG NHẬP SỐ HỢP LỆ"
        applyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Đóng / Mở Hub
closeBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.F4 then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- Ép tốc độ bằng CFrame (Bỏ qua giới hạn WalkSpeed của Game Simulator)
RunService.Heartbeat:Connect(function(delta)
    if isEnabled and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        
        if hum and root then
            -- Ép WalkSpeed cơ bản
            hum.WalkSpeed = targetSpeed
            
            -- Nếu game khóa WalkSpeed, dùng Vector Force dịch chuyển nhân vật nhanh hơn
            if hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (targetSpeed / 16 - 1) * 16 * delta)
            end
        end
    end
end)
