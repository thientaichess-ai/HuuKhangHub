-- Biến logic
local targetSpeed = 16
local isSpeedEnabled = false
local targetJumpPower = 50
local isJumpEnabled = false

applySpeedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(speedInput.Text)
    if val then
        targetSpeed = val
        isSpeedEnabled = true
        applySpeedBtn.Text = "ĐÃ BẬT TỐC ĐỘ: " .. tostring(val)
        applySpeedBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    else
        isSpeedEnabled = false
        applySpeedBtn.Text = "VUI LÒNG NHẬP SỐ HỢP LỆ"
        applySpeedBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

applyJumpBtn.MouseButton1Click:Connect(function()
    local val = tonumber(jumpInput.Text)
    if val then
        targetJumpPower = val
        isJumpEnabled = true
        applyJumpBtn.Text = "ĐÃ BẬT NHẢY: " .. tostring(val)
        applyJumpBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    else
        isJumpEnabled = false
        applyJumpBtn.Text = "VUI LÒNG NHẬP SỐ HỢP LỆ"
        applyJumpBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Ẩn / Hiện UI
