restoreBtn.Size = UDim2.new(0, 42, 0, 42)
restoreBtn.Position = UDim2.new(0.02, 0, 0.4, 0)
restoreBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
restoreBtn.Text = "+"
